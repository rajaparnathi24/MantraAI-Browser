# Local development only. Installed builds read firebase-config.json from app.getPath('userData').
# Firebase Web app settings for the mantraai-browser project.
# These values identify your Firebase app; they are not Admin/service-account secrets.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=mantraai-browser.firebaseapp.com
FIREBASE_PROJECT_ID=mantraai-browser
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=

# Google Cloud OAuth 2.0 client ID with application type "Desktop app".
# Never put an OAuth client secret in this application.
GOOGLE_OAUTH_CLIENT_ID=
